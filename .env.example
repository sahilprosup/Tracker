# Supabase project (see README for how these were provisioned)
NEXT_PUBLIC_SUPABASE_URL=https://hgoinurzxpylbornukqx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Slack incoming webhook for the daily report + checkpoint nudges.
# Create one at https://api.slack.com/apps -> your app -> Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Slack Bot Token (starts with xoxb-) - required for reading project channels
# (photos posted straight into Slack) and reacting to processed messages.
# See README "Slack channel ingestion" for the OAuth scopes needed. Without
# this, /api/cron/slack-ingest just no-ops.
SLACK_BOT_TOKEN=

# Comma-separated emails that get the "coordinator" role on first sign-in
# (can manage projects/ITP items, see reports, view the sync log).
COORDINATOR_EMAILS=sahil.john@prolinegroup.au

# Shared secret required on cron endpoints (?secret=... or Authorization: Bearer ...)
# so only your scheduler can trigger checkpoint checks / report generation.
CRON_SECRET=change-me

# Visibuild write-back (see lib/visibuild.ts). Confirmed against Visibuild's
# own "Uploading attachments via API" docs: presigned S3 upload, then a
# record is created referencing the returned key. Base URL defaults to
# https://app.apac.visibuild.com if unset. VISIBUILD_ACCESS_TOKEN is the
# Bearer token Visibuild issues for API access - ask Visibuild support how
# to obtain/refresh one, that part isn't documented in what we have.
VISIBUILD_API_BASE_URL=https://app.apac.visibuild.com
VISIBUILD_ACCESS_TOKEN=
